# =====================================================================
# sshd_config — CONTENEDOR ENDURECIDO (ssh-endurecido, 127.0.0.1:2222)
# ---------------------------------------------------------------------
# Configuración endurecida siguiendo Mozilla OpenSSH Guidelines (Modern)
# y CIS Benchmark. Cada directiva corrige una debilidad del inseguro.
# =====================================================================

Port 22

# [PREVENCIÓN] Prohíbe el login directo de root.
PermitRootLogin no

# [PREVENCIÓN] Solo autenticación por clave pública: elimina la fuerza
# bruta de contraseñas.
PasswordAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
KbdInteractiveAuthentication no

# [CONTENCIÓN] Máximo 3 intentos de autenticación por conexión.
MaxAuthTries 3
LoginGraceTime 30

# [PREVENCIÓN/CONTENCIÓN] Solo el usuario sin privilegios puede entrar.
AllowUsers axel

UsePAM yes

# [PREVENCIÓN] Solo algoritmos modernos y fuertes (sin SHA-1, sin CBC,
# sin 3DES, sin MAC débiles). Incluye intercambio post-cuántico.
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com

Subsystem sftp /usr/lib/openssh/sftp-server
